<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RootNamespace>Kuronuri.App</RootNamespace>
    <AssemblyName>Kuronuri</AssemblyName>
    <Product>公文書くろぬり</Product>
    <AssemblyTitle>公文書くろぬり</AssemblyTitle>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>kuronuri.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kuronuri.Core\Kuronuri.Core.csproj" />
    <!-- The user guide is shown in the help window (ARCHITECTURE §11.8). -->
    <EmbeddedResource Include="..\..\docs\USER_GUIDE.md" LogicalName="USER_GUIDE.md" Link="USER_GUIDE.md" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="ReachFramework" />
    <Reference Include="System.Printing" />
  </ItemGroup>
</Project>
