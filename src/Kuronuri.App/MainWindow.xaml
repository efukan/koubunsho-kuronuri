<Window x:Class="Kuronuri.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:Kuronuri.App.Themes"
        xmlns:local="clr-namespace:Kuronuri.App"
        Title="公文書くろぬり" Width="1400" Height="900" MinWidth="760" MinHeight="500"
        FontFamily="{StaticResource UiFont}" FontSize="13" Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Text.Primary}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <Window.CommandBindings>
    <CommandBinding Command="local:Cmd.Open" Executed="Open_Executed" />
    <CommandBinding Command="local:Cmd.SaveReview" Executed="SaveReview_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.SaveAs" Executed="SaveAs_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.Export" Executed="Export_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.PrintRedacted" Executed="PrintRedacted_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.PrintReview" Executed="PrintReview_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.Undo" Executed="Undo_Executed" CanExecute="Undo_CanExecute" />
    <CommandBinding Command="local:Cmd.Redo" Executed="Redo_Executed" CanExecute="Redo_CanExecute" />
    <CommandBinding Command="local:Cmd.Merge" Executed="Merge_Executed" CanExecute="Merge_CanExecute" />
    <CommandBinding Command="local:Cmd.Split" Executed="Split_Executed" CanExecute="Split_CanExecute" />
    <CommandBinding Command="local:Cmd.Delete" Executed="Delete_Executed" CanExecute="HasSelection_CanExecute" />
    <CommandBinding Command="local:Cmd.ZoomIn" Executed="ZoomIn_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.ZoomOut" Executed="ZoomOut_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.Zoom100" Executed="Zoom100_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.FitWidth" Executed="FitWidth_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.FitPage" Executed="FitPage_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.TogglePanes" Executed="TogglePanes_Executed" />
    <CommandBinding Command="local:Cmd.Settings" Executed="Settings_Executed" />
    <CommandBinding Command="local:Cmd.NextUnset" Executed="NextUnset_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.PrevUnset" Executed="PrevUnset_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.Find" Executed="Find_Executed" CanExecute="HasDoc_CanExecute" />
    <CommandBinding Command="local:Cmd.Help" Executed="Help_Executed" />
    <CommandBinding Command="local:Cmd.RotateRight" Executed="RotateRight_Executed" CanExecute="PageCmd_CanExecute" />
    <CommandBinding Command="local:Cmd.RotateLeft" Executed="RotateLeft_Executed" CanExecute="PageCmd_CanExecute" />
    <CommandBinding Command="local:Cmd.Rotate180" Executed="Rotate180_Executed" CanExecute="PageCmd_CanExecute" />
    <CommandBinding Command="local:Cmd.ToggleExclude" Executed="ToggleExclude_Executed" CanExecute="PageCmd_CanExecute" />
    <CommandBinding Command="local:Cmd.MovePageUp" Executed="MovePageUp_Executed" CanExecute="MovePageUp_CanExecute" />
    <CommandBinding Command="local:Cmd.MovePageDown" Executed="MovePageDown_Executed" CanExecute="MovePageDown_CanExecute" />
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Command="local:Cmd.Open" Gesture="Ctrl+O" />
    <KeyBinding Command="local:Cmd.SaveReview" Gesture="Ctrl+S" />
    <KeyBinding Command="local:Cmd.SaveAs" Gesture="Ctrl+Shift+S" />
    <KeyBinding Command="local:Cmd.Export" Gesture="Ctrl+E" />
    <KeyBinding Command="local:Cmd.PrintRedacted" Gesture="Ctrl+P" />
    <KeyBinding Command="local:Cmd.Undo" Gesture="Ctrl+Z" />
    <KeyBinding Command="local:Cmd.Redo" Gesture="Ctrl+Y" />
    <KeyBinding Command="local:Cmd.Merge" Gesture="Ctrl+G" />
    <KeyBinding Command="local:Cmd.Split" Gesture="Ctrl+Shift+G" />
    <KeyBinding Command="local:Cmd.Zoom100" Gesture="Ctrl+D1" />
    <KeyBinding Command="local:Cmd.FitWidth" Gesture="Ctrl+D2" />
    <KeyBinding Command="local:Cmd.FitPage" Gesture="Ctrl+D0" />
    <KeyBinding Command="local:Cmd.ZoomIn" Gesture="Ctrl+OemPlus" />
    <KeyBinding Command="local:Cmd.ZoomOut" Gesture="Ctrl+OemMinus" />
    <KeyBinding Command="local:Cmd.ZoomIn" Gesture="Ctrl+Add" />
    <KeyBinding Command="local:Cmd.ZoomOut" Gesture="Ctrl+Subtract" />
    <KeyBinding Command="local:Cmd.Zoom100" Gesture="Ctrl+NumPad1" />
    <KeyBinding Command="local:Cmd.FitWidth" Gesture="Ctrl+NumPad2" />
    <KeyBinding Command="local:Cmd.FitPage" Gesture="Ctrl+NumPad0" />
    <KeyBinding Command="local:Cmd.TogglePanes" Gesture="F6" />
    <KeyBinding Command="local:Cmd.NextUnset" Gesture="F8" />
    <KeyBinding Command="local:Cmd.PrevUnset" Gesture="Shift+F8" />
    <KeyBinding Command="local:Cmd.Find" Gesture="Ctrl+F" />
    <KeyBinding Command="local:Cmd.Help" Gesture="F1" />
    <KeyBinding Command="local:Cmd.RotateRight" Gesture="Ctrl+R" />
    <KeyBinding Command="local:Cmd.RotateLeft" Gesture="Ctrl+Shift+R" />
  </Window.InputBindings>

  <DockPanel>
    <!-- Command bar (ARCHITECTURE §11.1 / §11.7). When narrow, labels are hidden first (Compact); groups then wrap onto a second row. -->
    <Border x:Name="commandBarHost" DockPanel.Dock="Top" Background="{DynamicResource Bg.Bar}" BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="0,0,0,1" Padding="8,5" SizeChanged="CommandBarHost_SizeChanged">
      <WrapPanel x:Name="commandBar" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <t:IconButton Icon="&#xE8E5;" Label="開く" Command="local:Cmd.Open" ToolTip="開く (Ctrl+O): 原本のPDF、または作業途中の確認用PDFを開きます" />
          <t:IconButton Icon="&#xE74E;" Label="保存" IsDropDown="True" ToolTip="作業内容を確認用PDFに保存します（原本は書き換えません）">
            <t:IconButton.ContextMenu>
              <ContextMenu>
                <MenuItem Header="確認用PDFに保存" Command="local:Cmd.SaveReview" InputGestureText="Ctrl+S" />
                <MenuItem Header="名前を付けて確認用PDFに保存…" Command="local:Cmd.SaveAs" InputGestureText="Ctrl+Shift+S" />
              </ContextMenu>
            </t:IconButton.ContextMenu>
          </t:IconButton>
          <t:IconButton Icon="&#xE896;" Label="開示用PDFを作成" KeepLabel="True" Command="local:Cmd.Export" ToolTip="開示用PDFを作成 (Ctrl+E): 黒塗りを画像に焼き込んだ、外部に交付するPDFを作ります" />
          <t:IconButton Icon="&#xE749;" Label="印刷" IsDropDown="True" ToolTip="印刷">
            <t:IconButton.ContextMenu>
              <ContextMenu>
                <MenuItem Header="黒塗りした状態で印刷" Command="local:Cmd.PrintRedacted" InputGestureText="Ctrl+P" />
                <MenuItem Header="確認用として印刷（原本の内容が見えます）" Command="local:Cmd.PrintReview" />
              </ContextMenu>
            </t:IconButton.ContextMenu>
          </t:IconButton>
        </StackPanel>
        <Border Style="{StaticResource BarSeparator}" />
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <t:IconButton Icon="&#xE7A7;" Command="local:Cmd.Undo" ToolTip="元に戻す (Ctrl+Z)" />
          <t:IconButton Icon="&#xE7A6;" Command="local:Cmd.Redo" ToolTip="やり直し (Ctrl+Y)" />
        </StackPanel>
        <Border Style="{StaticResource BarSeparator}" />
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <t:IconRadio x:Name="toolHand" Icon="&#xE815;" GroupName="tool" IsChecked="True" Checked="Tool_Checked" Tag="Hand" ToolTip="てのひら (H): ドラッグで表示位置を動かす（黒塗りは変えない）" />
          <t:IconRadio x:Name="toolSelect" Icon="&#xE8B0;" GroupName="tool" Checked="Tool_Checked" Tag="Select" ToolTip="選択 (V): 箇所をクリックで選び、ドラッグで移動・大きさ変更" />
          <t:IconRadio x:Name="toolRect" Icon="&#xE739;" GroupName="tool" Checked="Tool_Checked" Tag="Rect" ToolTip="矩形 (R): ドラッグして四角く黒塗り" />
          <t:IconRadio x:Name="toolText" Icon="&#xE8D2;" GroupName="tool" Checked="Tool_Checked" Tag="Text" ToolTip="文字 (T): 文字の上をドラッグすると、その文字を行ごとに覆います" />
          <t:IconRadio x:Name="toolFree" Icon="&#xE76D;" GroupName="tool" Checked="Tool_Checked" Tag="Freehand" ToolTip="手書き (B): なぞって黒塗り（近くの線は1つの箇所にまとまります）" />
          <t:IconRadio x:Name="toolEraser" Icon="&#xECC9;" GroupName="tool" Checked="Tool_Checked" Tag="Eraser" ToolTip="図形を削除 (E): クリックした黒塗りの図形を1つまるごと削除（ポインタを重ねると消える図形が赤く表示されます）" />
          <ComboBox x:Name="brushCombo" Width="78" Margin="6,0,0,0" VerticalAlignment="Center" SelectionChanged="Brush_SelectionChanged" ToolTip="フリーハンドの太さ ( [ / ] )" />
        </StackPanel>
        <Border Style="{StaticResource BarSeparator}" />
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <TextBlock Text="理由" VerticalAlignment="Center" Margin="2,0,8,0" Foreground="{DynamicResource Text.Secondary}" />
          <ComboBox x:Name="currentReasonCombo" Width="150" VerticalAlignment="Center" SelectionChanged="CurrentReason_SelectionChanged" ToolTip="これから作る黒塗り箇所に付ける理由（作った後でも変えられます）" />
        </StackPanel>
        <Border Style="{StaticResource BarSeparator}" />
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <t:IconButton Icon="&#xE71B;" Command="local:Cmd.Merge" ToolTip="結合 (Ctrl+G): 同じページの複数の箇所を1つにまとめます" />
          <t:IconButton Icon="&#xE8C6;" Command="local:Cmd.Split" ToolTip="分割 (Ctrl+Shift+G): 1つの箇所を図形ごとに分けます" />
          <t:IconButton Icon="&#xE74D;" Command="local:Cmd.Delete" ToolTip="削除 (Delete): 選んだ箇所を消す" />
          <t:IconButton Icon="&#xE7BA;" Command="local:Cmd.NextUnset" ToolTip="次の未設定 (F8): 理由が設定されていない箇所へ順に移動（Shift+F8 で前へ）" />
          <t:IconButton Icon="&#xE721;" Label="検索" Command="local:Cmd.Find" ToolTip="語句や電話番号などを検索して、まとめて黒塗りにします (Ctrl+F)" />
        </StackPanel>
        <Border Style="{StaticResource BarSeparator}" />
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <t:IconButton Icon="&#xE7C3;" Label="ページ" IsDropDown="True" ToolTip="表示中のページの回転・除外・並べ替え">
            <t:IconButton.ContextMenu>
              <ContextMenu Opened="PageMenu_Opened">
                <MenuItem Header="右に90°回転" Command="local:Cmd.RotateRight" InputGestureText="Ctrl+R" />
                <MenuItem Header="左に90°回転" Command="local:Cmd.RotateLeft" InputGestureText="Ctrl+Shift+R" />
                <MenuItem Header="180°回転" Command="local:Cmd.Rotate180" />
                <Separator />
                <MenuItem x:Name="excludeMenuBar" Header="開示用PDFから除く" Command="local:Cmd.ToggleExclude" />
                <Separator />
                <MenuItem Header="前へ移動" Command="local:Cmd.MovePageUp" />
                <MenuItem Header="後ろへ移動" Command="local:Cmd.MovePageDown" />
              </ContextMenu>
            </t:IconButton.ContextMenu>
          </t:IconButton>
          <t:IconButton x:Name="styleButton" Icon="&#xE790;" Label="黒塗り" IsDropDown="True" ToolTip="スタイル（文書全体に適用）">
            <t:IconButton.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="styleBlack" Header="黒塗り" IsChecked="True" Click="StyleMenu_Click" Tag="Black" />
                <MenuItem x:Name="styleWhite" Header="白塗り+黒枠" Click="StyleMenu_Click" Tag="White" />
              </ContextMenu>
            </t:IconButton.ContextMenu>
          </t:IconButton>
        </StackPanel>
        <Border Style="{StaticResource BarSeparator}" />
        <StackPanel Orientation="Horizontal" Margin="0,2">
          <t:IconButton Icon="&#xE890;" Label="表示" IsDropDown="True" ToolTip="表示の切り替え">
            <t:IconButton.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="twoPane" Header="2画面で表示（原本と並べる）" IsCheckable="True" IsChecked="True" Checked="Panes_Checked" Unchecked="Panes_Checked" InputGestureText="F6" />
                <MenuItem x:Name="originalSameZoom" Header="原本を同じ倍率で表示" IsCheckable="True" Checked="OriginalSameZoom_Changed" Unchecked="OriginalSameZoom_Changed"
                          ToolTip="オン: 原本側が狭くても縮小せず、プレビューと同じ文字の大きさで中央の部分を表示します。オフ: プレビューと同じ範囲を縮小して表示します" />
                <MenuItem x:Name="showThumbs" Header="ページ一覧" IsCheckable="True" IsChecked="True" Checked="Panels_Changed" Unchecked="Panels_Changed" />
                <MenuItem x:Name="showList" Header="箇所リスト・検索" IsCheckable="True" IsChecked="True" Checked="Panels_Changed" Unchecked="Panels_Changed" />
                <MenuItem x:Name="continuousPages" Header="ページを続けて表示" IsCheckable="True" IsChecked="True" Checked="Continuous_Changed" Unchecked="Continuous_Changed"
                          ToolTip="オン: ページを縦に続けて並べ、スクロールでそのまま次のページへ進みます。オフ: 1ページずつ表示し、ページの端でさらにスクロールすると次のページへ移ります" />
                <Separator />
                <MenuItem Header="拡大" Command="local:Cmd.ZoomIn" InputGestureText="Ctrl++" />
                <MenuItem Header="縮小" Command="local:Cmd.ZoomOut" InputGestureText="Ctrl+-" />
                <MenuItem Header="100%" Command="local:Cmd.Zoom100" InputGestureText="Ctrl+1" />
                <MenuItem Header="幅に合わせる" Command="local:Cmd.FitWidth" InputGestureText="Ctrl+2" />
                <MenuItem Header="全体" Command="local:Cmd.FitPage" InputGestureText="Ctrl+0" />
                <Separator />
                <MenuItem Header="テーマ">
                  <MenuItem x:Name="themeLight" Header="ライト" IsCheckable="True" Click="Theme_Click" Tag="light" />
                  <MenuItem x:Name="themeDark" Header="ダーク" IsCheckable="True" Click="Theme_Click" Tag="dark" />
                </MenuItem>
              </ContextMenu>
            </t:IconButton.ContextMenu>
          </t:IconButton>
          <t:IconButton Icon="&#xE713;" Command="local:Cmd.Settings" ToolTip="設定" />
          <t:IconButton Icon="&#xE897;" Command="local:Cmd.Help" ToolTip="使い方 (F1)" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="prevPageButton" Content="&#xE76B;" FontFamily="{StaticResource IconFont}" Style="{StaticResource SubtleButton}" Click="PrevPage_Click" ToolTip="前のページ (PageUp)" />
          <TextBlock Text="ページ" VerticalAlignment="Center" Margin="4,0,4,0" />
          <TextBox x:Name="pageBox" Width="44" TextAlignment="Right" KeyDown="PageBox_KeyDown" LostKeyboardFocus="PageBox_LostFocus" ToolTip="ページ番号を入れて Enter" />
          <TextBlock x:Name="pageCountText" Text="/ -" VerticalAlignment="Center" Margin="4,0,4,0" />
          <Button x:Name="nextPageButton" Content="&#xE76C;" FontFamily="{StaticResource IconFont}" Style="{StaticResource SubtleButton}" Click="NextPage_Click" ToolTip="次のページ (PageDown)" />
        </StackPanel>
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <ComboBox x:Name="zoomBox" Width="110" IsEditable="True" KeyDown="ZoomBox_KeyDown" SelectionChanged="ZoomBox_SelectionChanged" LostKeyboardFocus="ZoomBox_LostFocus" ToolTip="ズーム（数字を入れて Enter でも指定できます）">
          <ComboBoxItem Content="25%" />
          <ComboBoxItem Content="50%" />
          <ComboBoxItem Content="75%" />
          <ComboBoxItem Content="100%" />
          <ComboBoxItem Content="150%" />
          <ComboBoxItem Content="200%" />
          <ComboBoxItem Content="400%" />
          <ComboBoxItem Content="幅に合わせる" />
          <ComboBoxItem Content="全体" />
        </ComboBox>
      </StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock x:Name="stItems" Text="箇所 0" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock x:Name="stUnset" Text="理由未設定 0" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock x:Name="stState" Text="ファイルが開かれていません" TextTrimming="CharacterEllipsis" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock x:Name="stHint" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /></StatusBarItem>
    </StatusBar>

    <Grid x:Name="mainGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="colThumbs" Width="160" MinWidth="100" />
        <ColumnDefinition x:Name="colSplit1" Width="4" />
        <ColumnDefinition x:Name="colLeft" Width="*" MinWidth="200" />
        <ColumnDefinition x:Name="colGap" Width="4" />
        <ColumnDefinition x:Name="colRight" Width="*" MinWidth="200" />
        <ColumnDefinition x:Name="colSplit2" Width="4" />
        <ColumnDefinition x:Name="colList" Width="320" MinWidth="200" />
      </Grid.ColumnDefinitions>

      <ListBox x:Name="thumbList" Grid.Column="0" SelectionMode="Single" SelectionChanged="Thumb_SelectionChanged"
               AllowDrop="True" PreviewMouseLeftButtonDown="Thumb_PreviewMouseLeftButtonDown" PreviewMouseMove="Thumb_PreviewMouseMove"
               DragOver="Thumb_DragOver" Drop="Thumb_Drop" ContextMenuOpening="Thumb_ContextMenuOpening"
               ToolTip="ドラッグで並べ替え・右クリックで回転や除外"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="右に90°回転" Command="local:Cmd.RotateRight" InputGestureText="Ctrl+R" />
            <MenuItem Header="左に90°回転" Command="local:Cmd.RotateLeft" InputGestureText="Ctrl+Shift+R" />
            <MenuItem Header="180°回転" Command="local:Cmd.Rotate180" />
            <Separator />
            <MenuItem x:Name="excludeMenuThumb" Header="開示用PDFから除く" Command="local:Cmd.ToggleExclude" />
            <Separator />
            <MenuItem Header="前へ移動" Command="local:Cmd.MovePageUp" />
            <MenuItem Header="後ろへ移動" Command="local:Cmd.MovePageDown" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type local:ThumbVM}">
            <StackPanel Margin="4">
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center"><!-- shrinks when the page list is narrower than the card -->
              <Grid>
                <Border x:Name="pageCard" BorderBrush="{DynamicResource Stroke.Card}" BorderThickness="1" Background="White">
                  <Grid>
                    <Image Source="{Binding Image}" Width="120" Height="{Binding HeightDip}" Stretch="Fill" />
                    <Image Source="{Binding Overlay}" Width="120" Height="{Binding HeightDip}" Stretch="Fill" />
                  </Grid>
                </Border>
                <Border x:Name="excludedTag" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-4,0,0,-4" CornerRadius="4" Padding="6,1"
                        Background="#FFC42B1C" Visibility="Collapsed" ToolTip="開示用PDFに含めないページです">
                  <TextBlock Text="除外" Foreground="White" FontWeight="Bold" FontSize="11" />
                </Border>
                <Border x:Name="badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" MinWidth="20" Height="20"
                        CornerRadius="10" Padding="5,0" Background="#FF0054A6" Visibility="Collapsed" ToolTip="{Binding BadgeToolTip}">
                  <TextBlock Text="{Binding Count}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
              </Viewbox>
              <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding HasItems}" Value="True">
                <Setter TargetName="badge" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Excluded}" Value="True">
                <Setter TargetName="excludedTag" Property="Visibility" Value="Visible" />
                <Setter TargetName="pageCard" Property="Opacity" Value="0.45" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HasUnset}" Value="True">
                <Setter TargetName="badge" Property="Background" Value="#FFD66200" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter x:Name="split1" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" DragCompleted="SideSplitter_DragCompleted" />

      <Grid Grid.Column="2" x:Name="leftHost">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Padding="10,4"><TextBlock Text="原本（閲覧のみ）" Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" /></Border>
        <local:PageCanvas x:Name="leftCanvas" Grid.Row="1" />
        <ScrollBar x:Name="leftV" Grid.Row="1" Grid.Column="1" Orientation="Vertical" Scroll="ScrollBar_Scroll" />
        <ScrollBar x:Name="leftH" Grid.Row="2" Orientation="Horizontal" Scroll="ScrollBar_Scroll" />
      </Grid>
      <GridSplitter x:Name="splitPanes" Grid.Column="3" Width="4" HorizontalAlignment="Stretch" DragCompleted="SplitPanes_DragCompleted" MouseDoubleClick="SplitPanes_DoubleClick"
                    ToolTip="ドラッグで原本とプレビューの幅を変更（ダブルクリックで半分ずつに戻す）" />
      <Grid Grid.Column="4" x:Name="rightHost">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Padding="10,4">
          <DockPanel>
            <TextBlock x:Name="autoPaneNote" DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Visibility="Collapsed"
                       Text="幅が狭いため原本を隠しています" ToolTip="ウィンドウを広げるか、ページ一覧・箇所リストを狭く（または非表示に）すると、原本と並べて表示します" />
            <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextTrimming="CharacterEllipsis"><Run Text="黒塗りプレビュー（編集）" Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" /><Run Text="   Space 押下中は透過" /></TextBlock>
          </DockPanel>
        </Border>
        <local:PageCanvas x:Name="rightCanvas" Grid.Row="1" />
        <Border x:Name="excludedBanner" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="8,8,8,0" Padding="12,5" CornerRadius="6"
                Background="#E6C42B1C" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Text="このページは開示用PDFに含めません（確認用PDFには残ります）" />
        </Border>
        <ScrollBar x:Name="rightV" Grid.Row="1" Grid.Column="1" Orientation="Vertical" Scroll="ScrollBar_Scroll" />
        <ScrollBar x:Name="rightH" Grid.Row="2" Orientation="Horizontal" Scroll="ScrollBar_Scroll" />
      </Grid>
      <GridSplitter x:Name="split2" Grid.Column="5" Width="4" HorizontalAlignment="Stretch" DragCompleted="SideSplitter_DragCompleted" />

      <TabControl Grid.Column="6" x:Name="sidePanel" BorderThickness="0" Padding="0">
        <TabItem Header="箇所リスト" x:Name="listTab">
          <DockPanel x:Name="listPanel">
            <Border DockPanel.Dock="Top" Padding="8,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Command="local:Cmd.NextUnset" Padding="6,1" ToolTip="次の未設定へ (F8)">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="次の未設定" />
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" Margin="4,2,0,0" FontSize="10" />
                  </StackPanel>
                </Button>
                <TextBlock Text="クリックで移動・右クリックでメニュー" Foreground="{DynamicResource Text.Secondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg.Bar}" BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="0,1,0,0" Padding="10,8">
              <StackPanel>
                <TextBlock x:Name="reasonEditTitle" Text="選択した箇所の理由" Margin="0,0,0,3" />
                <ComboBox x:Name="reasonEditCombo" SelectionChanged="ReasonEdit_SelectionChanged" IsEnabled="False" />
                <TextBlock Text="自由記述" Margin="0,6,0,3" />
                <TextBox x:Name="freeTextEdit" IsEnabled="False" LostKeyboardFocus="FreeText_LostFocus" KeyDown="FreeText_KeyDown" />
              </StackPanel>
            </Border>
            <ListView x:Name="itemList" SelectionMode="Extended" SelectionChanged="ItemList_SelectionChanged"
                      PreviewMouseLeftButtonUp="ItemList_PreviewMouseLeftButtonUp" ContextMenuOpening="ItemList_ContextMenuOpening"
                      BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" SizeChanged="ItemList_SizeChanged">
              <ListView.ContextMenu>
                <ContextMenu />
              </ListView.ContextMenu>
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUnset}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Bg.Warn.Row}" />
                      <Setter Property="ToolTip" Value="理由が設定されていません" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="番号" Width="40" DisplayMemberBinding="{Binding Number}" />
                  <GridViewColumn Header="頁" Width="36" DisplayMemberBinding="{Binding Page}" />
                  <GridViewColumn x:Name="reasonColumn" Header="理由" Width="160" DisplayMemberBinding="{Binding ReasonText}" />
                  <GridViewColumn Header="種別" Width="64">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Kind}">
                          <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}" Margin="0,1,4,0" />
                          <TextBlock Text="{Binding Kind}" />
                        </StackPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>

        <TabItem Header="検索" x:Name="searchTab">
          <DockPanel Margin="6">
            <StackPanel DockPanel.Dock="Top">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="検索" Width="56" Margin="4,0,0,0" Click="Search_Click" />
                <TextBox x:Name="searchBox" KeyDown="SearchBox_KeyDown" ToolTip="語句（全角・半角、大文字・小文字は区別しません）" />
              </DockPanel>
              <WrapPanel Margin="0,6,0,0">
                <ComboBox x:Name="presetCombo" Width="150" Margin="0,0,0,4" SelectionChanged="Preset_SelectionChanged" ToolTip="定型のパターンで検索します" />
                <CheckBox x:Name="regexCheck" Content="正規表現" Margin="8,0,0,4" VerticalAlignment="Center" />
                <CheckBox x:Name="ignoreSpaceCheck" Content="空白を無視" Margin="8,0,0,4" VerticalAlignment="Center" IsChecked="True" />
              </WrapPanel>
              <TextBlock x:Name="searchStatus" Margin="0,6,0,4" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal">
                <Button Content="すべて選ぶ" Padding="6,1" Click="SearchSelectAll_Click" />
                <Button Content="選択を外す" Padding="6,1" Margin="4,0,0,0" Click="SearchSelectNone_Click" />
              </StackPanel>
              <Button x:Name="searchApplyButton" Style="{StaticResource AccentButton}" Content="選んだ箇所を黒塗りにする" Margin="0,6,0,0" Padding="6,4" FontWeight="Bold" Click="SearchApply_Click" IsEnabled="False" />
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" FontSize="11"
                         Text="文字情報のない部分（スキャン画像・図の中の文字など）は検索できません。黒塗り漏れがないか、必ず目視でも確認してください。" />
            </StackPanel>
            <ListView x:Name="searchList" SelectionMode="Single" SelectionChanged="SearchList_SelectionChanged" SizeChanged="SearchList_SizeChanged" BorderThickness="1" BorderBrush="{DynamicResource Stroke.Control}">
              <ListView.View>
                <GridView>
                  <GridViewColumn Width="30">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" /></DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="頁" Width="36" DisplayMemberBinding="{Binding Page}" />
                  <GridViewColumn x:Name="previewColumn" Header="内容" Width="190" DisplayMemberBinding="{Binding Preview}" />
                  <GridViewColumn Header="" Width="30" DisplayMemberBinding="{Binding State}" />
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </TabItem>
      </TabControl>

      <!-- Start screen (ARCHITECTURE §11.8): shown while no document is open. -->
      <Border x:Name="startScreen" Grid.ColumnSpan="7" Background="{DynamicResource Bg.Window}" Panel.ZIndex="5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="760" Margin="32" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="公文書くろぬり" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,24" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"
                       Text="PDF の一部を黒塗りして、外部に交付できる「開示用PDF」を作ります。原本のPDFは書き換えません。" />
            <UniformGrid Columns="3" Margin="0,0,0,24">
              <Border Background="{DynamicResource Bg.Layer}" BorderBrush="{DynamicResource Stroke.Card}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="1" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Accent.Text}" />
                  <TextBlock Text="PDFを開く" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,6" />
                  <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Text="黒塗りしたい原本、または作業途中の「確認用PDF」を開きます。" />
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource Bg.Layer}" BorderBrush="{DynamicResource Stroke.Card}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0">
                <StackPanel>
                  <TextBlock Text="2" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Accent.Text}" />
                  <TextBlock Text="黒塗りして理由を付ける" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,6" />
                  <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Text="矩形・文字・手書きで黒塗りし、号番号を選びます。語句の検索でまとめて黒塗りもできます。" />
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource Bg.Layer}" BorderBrush="{DynamicResource Stroke.Card}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                  <TextBlock Text="3" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Accent.Text}" />
                  <TextBlock Text="開示用PDFを作成" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,6" />
                  <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Text="黒塗りを画像に焼き込んだPDFを作り、下の文字が残っていないことを自動で検証します。" />
                </StackPanel>
              </Border>
            </UniformGrid>
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource AccentButton}" Command="local:Cmd.Open" Padding="18,7">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="PDFを開く (Ctrl+O)" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Command="local:Cmd.Help" Margin="8,0,0,0" Padding="14,7">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="使い方 (F1)" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                       Text="PDF ファイルをこの画面にドラッグしても開けます。作業の途中は「確認用PDF」として保存すると、後から続きを作業できます。" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- In-window notifications (ARCHITECTURE §11.8). -->
      <local:InfoBar x:Name="infoBar" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Top" Margin="24,36,24,0" Panel.ZIndex="10" />
    </Grid>
  </DockPanel>
</Window>
