<!-- Windows 11 style dark palette. Keys must match Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg.Window" Color="#202020" />
  <SolidColorBrush x:Key="Bg.Bar" Color="#272727" />
  <SolidColorBrush x:Key="Bg.Layer" Color="#2B2B2B" />
  <SolidColorBrush x:Key="Bg.Popup" Color="#2C2C2C" />
  <SolidColorBrush x:Key="Bg.Canvas" Color="#1A1A1A" />
  <SolidColorBrush x:Key="Bg.Control" Color="#2D2D2D" />
  <SolidColorBrush x:Key="Bg.Control.Hover" Color="#323232" />
  <SolidColorBrush x:Key="Bg.Control.Disabled" Color="#262626" />
  <SolidColorBrush x:Key="Bg.Subtle.Hover" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="Bg.Subtle.Pressed" Color="#0AFFFFFF" />
  <SolidColorBrush x:Key="Bg.Subtle.Selected" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Bg.Warn.Row" Color="#433519" />

  <SolidColorBrush x:Key="Stroke.Control" Color="#3A3A3A" />
  <SolidColorBrush x:Key="Stroke.Control.Strong" Color="#9A9A9A" />
  <SolidColorBrush x:Key="Stroke.Divider" Color="#333333" />
  <SolidColorBrush x:Key="Stroke.Card" Color="#1C1C1C" />

  <SolidColorBrush x:Key="Text.Primary" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Text.Secondary" Color="#C5C5C5" />
  <SolidColorBrush x:Key="Text.Disabled" Color="#717171" />
  <SolidColorBrush x:Key="Text.OnAccent" Color="#000000" />
  <SolidColorBrush x:Key="Text.Warn" Color="#FCE100" />

  <SolidColorBrush x:Key="Accent" Color="#60CDFF" />
  <SolidColorBrush x:Key="Accent.Hover" Color="#5AB9E6" />
  <SolidColorBrush x:Key="Accent.Pressed" Color="#52A7CF" />
  <SolidColorBrush x:Key="Accent.Subtle" Color="#2260CDFF" />
  <SolidColorBrush x:Key="Accent.Text" Color="#60CDFF" />

  <SolidColorBrush x:Key="InfoBar.Success.Bg" Color="#393D1B" />
  <SolidColorBrush x:Key="InfoBar.Success.Icon" Color="#6CCB5F" />
  <SolidColorBrush x:Key="InfoBar.Info.Bg" Color="#2B2B2B" />
  <SolidColorBrush x:Key="InfoBar.Info.Icon" Color="#60CDFF" />
  <SolidColorBrush x:Key="InfoBar.Warning.Bg" Color="#433519" />
  <SolidColorBrush x:Key="InfoBar.Warning.Icon" Color="#FCE100" />
</ResourceDictionary>
