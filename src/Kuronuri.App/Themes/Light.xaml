<!-- Windows 11 style light palette. Keys must match Dark.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg.Window" Color="#F3F3F3" />
  <SolidColorBrush x:Key="Bg.Bar" Color="#F9F9F9" />
  <SolidColorBrush x:Key="Bg.Layer" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Bg.Popup" Color="#F9F9F9" />
  <SolidColorBrush x:Key="Bg.Canvas" Color="#E6E6E6" />
  <SolidColorBrush x:Key="Bg.Control" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Bg.Control.Hover" Color="#F9F9F9" />
  <SolidColorBrush x:Key="Bg.Control.Disabled" Color="#F5F5F5" />
  <SolidColorBrush x:Key="Bg.Subtle.Hover" Color="#0F000000" />
  <SolidColorBrush x:Key="Bg.Subtle.Pressed" Color="#09000000" />
  <SolidColorBrush x:Key="Bg.Subtle.Selected" Color="#0F000000" />
  <SolidColorBrush x:Key="Bg.Warn.Row" Color="#FFF4CE" />

  <SolidColorBrush x:Key="Stroke.Control" Color="#E5E5E5" />
  <SolidColorBrush x:Key="Stroke.Control.Strong" Color="#8A8A8A" />
  <SolidColorBrush x:Key="Stroke.Divider" Color="#E5E5E5" />
  <SolidColorBrush x:Key="Stroke.Card" Color="#E0E0E0" />

  <SolidColorBrush x:Key="Text.Primary" Color="#1A1A1A" />
  <SolidColorBrush x:Key="Text.Secondary" Color="#5D5D5D" />
  <SolidColorBrush x:Key="Text.Disabled" Color="#A0A0A0" />
  <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Text.Warn" Color="#9D5D00" />

  <SolidColorBrush x:Key="Accent" Color="#005FB8" />
  <SolidColorBrush x:Key="Accent.Hover" Color="#1A6FC2" />
  <SolidColorBrush x:Key="Accent.Pressed" Color="#3B82C7" />
  <SolidColorBrush x:Key="Accent.Subtle" Color="#1A005FB8" />
  <SolidColorBrush x:Key="Accent.Text" Color="#005FB8" />

  <SolidColorBrush x:Key="InfoBar.Success.Bg" Color="#DFF6DD" />
  <SolidColorBrush x:Key="InfoBar.Success.Icon" Color="#0F7B0F" />
  <SolidColorBrush x:Key="InfoBar.Info.Bg" Color="#F6F6F6" />
  <SolidColorBrush x:Key="InfoBar.Info.Icon" Color="#005FB8" />
  <SolidColorBrush x:Key="InfoBar.Warning.Bg" Color="#FFF4CE" />
  <SolidColorBrush x:Key="InfoBar.Warning.Icon" Color="#9D5D00" />
</ResourceDictionary>
